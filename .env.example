# Root-level environment variables are not used directly.
# See apps/api/.env.example and apps/web/env.example for per-app configuration.
#
# Backend (apps/api/.env):
#   MONGO_CONNECTION_STRING=
#   AZURE_STORAGE_CONNECTION_STRING=
#   NAME=
#   POTREE_PATH=/app/bin/PotreeConverter
#
# Frontend (apps/web/.env):
#   PUBLIC_API_BASE_URL=http://localhost:8000
#   PUBLIC_MAPTILER_API_KEY=
#   PUBLIC_APP_BASE_PATH=/cloud-viewer
