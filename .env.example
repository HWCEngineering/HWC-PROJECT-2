# ============================================================
# HWC Cloud Viewer - Environment Variables
# ============================================================
# Copy this file to .env and fill in values for local development.
# See README.md for full documentation of each variable.

# ─── Backend (apps/api) ───────────────────────────────────────
# MongoDB connection string (Atlas or local)
MONGO_CONNECTION_STRING=""

# Azure Blob Storage connection string
AZURE_STORAGE_CONNECTION_STRING=""

# Database and container name (used for both MongoDB db name and Blob container)
NAME="hwc-potree"

# Path to PotreeConverter binary (only needed for local non-Docker development)
# POTREE_PATH="/path/to/PotreeConverter"

# ─── Frontend (apps/web) ──────────────────────────────────────
# Backend API URL (local development)
PUBLIC_API_BASE_URL="http://localhost:8000"

# MapTiler API key (get one at https://www.maptiler.com/)
PUBLIC_MAPTILER_API_KEY=""

# App base path (default: /cloud-viewer)
PUBLIC_APP_BASE_PATH="/cloud-viewer"
